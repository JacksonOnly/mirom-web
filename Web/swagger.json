  "paths": {
    "/api/system/products": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "api-system-products-Get",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RESTfulResult_Dictionary_StringString"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RESTfulResult_Dictionary_StringString"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RESTfulResult_Dictionary_StringString"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/full-rom/{product}": {
      "post": {
        "tags": [
          "system"
        ],
        "operationId": "api-system-full-rom-product-Post",
        "parameters": [
          {
            "name": "product",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RESTfulResult_FullRomData"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RESTfulResult_FullRomData"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RESTfulResult_FullRomData"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/phone-info": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "api-system-phone-info-Get",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "<br />&nbsp; Token = 0<br />&nbsp; CPUID = 1<br />&nbsp; IMEI = 2<br />&nbsp; SN = 3<br />",
            "schema": {
              "$ref": "#/components/schemas/KeywordType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RESTfulResult_PhoneInfo"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RESTfulResult_PhoneInfo"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RESTfulResult_PhoneInfo"
                }
              }
            }
          }
        }
      }
    }
  },
